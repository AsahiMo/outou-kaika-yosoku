{
  "name": "outou-kaika-yosoku",
  "version": "0.1.0",
  "description": "アメダスの毎時気温データから、おうとう(桜桃)の開花日を予測するプログラム",
  "type": "module",
  "private": true,
  "scripts": {
    "fetch-season": "node scripts/fetch-season.mjs",
    "build-climatology": "node scripts/build-climatology.mjs",
    "predict": "node scripts/predict-flowering.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
